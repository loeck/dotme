{
  "name": "dotme",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "benchmark:scene": "node scripts/benchmark-scene.ts",
    "lint": "oxlint --type-aware --deny-warnings",
    "lint:fix": "oxlint --type-aware --fix",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm fmt:check && pnpm knip && pnpm test && pnpm build && pnpm bundle:size && pnpm csp",
    "prepare": "husky",
    "bundle:size": "node scripts/bundle-size.ts",
    "csp": "node scripts/csp.ts",
    "knip": "knip"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "26.6.6",
    "@types/three": "0.187.0",
    "happy-dom": "20.14.5",
    "husky": "9.1.7",
    "knip": "6.44.2",
    "lint-staged": "17.6.0",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2005",
    "tailwindcss": "4.3.4",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,cjs,mjs,cts,mts}": [
      "oxlint --type-aware --deny-warnings --fix",
      "oxfmt"
    ],
    "*.{json,jsonc,css,md,html}": [
      "oxfmt"
    ]
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "26.x"
  },
  "packageManager": "pnpm@12.5.1"
}
